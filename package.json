{
  "name": "prevu",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "bun run --cwd frontend dev",
    "build": "bun run --cwd frontend build",
    "website:dev": "bun run --cwd docs/webpage dev",
    "website:build": "bun run --cwd docs/webpage build",
    "website:preview": "bun run --cwd docs/webpage preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "cli": "cargo run --manifest-path cli/Cargo.toml --"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0"
  }
}
